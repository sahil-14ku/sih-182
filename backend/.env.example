# =================================================================
# VASPTrace Backend Environment Configuration Example
# Copy this file to .env and configure for your local/production environment
# DO NOT commit real secrets or production credentials
# =================================================================

# Server Environment
NODE_ENV=development
PORT=4000

# MongoDB Configuration
# For local MongoDB: mongodb://localhost:27017/vasptrace
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/vasptrace?retryWrites=true&w=majority
# If omitted or invalid, VASPTrace will automatically run in Fallback Demo Mode
MONGODB_URI=mongodb://localhost:27017/vasptrace

# JWT Authentication Secrets
JWT_SECRET=vasptrace_dev_jwt_secret_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CORS_ORIGIN=http://localhost:3000

# Demonstration / Fallback Mode
# Set to 'true' to always allow demo datasets or 'false' for strict DB operations
DEMO_MODE=true
